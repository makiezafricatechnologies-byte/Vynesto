rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Master Security Rules for Frewsie Shop
     * 
     * SUPER ADMIN OVERRIDE:
     * Ezra Maina (ezramainak@gmail.com) has unconditional access.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isEzra() {
      return isSignedIn() && (
        request.auth.token.email == 'ezramainak@gmail.com' || 
        request.auth.uid == 'IELPepYQ6FTIWJ1ZWrDJFQFhn5C3'
      );
    }

    // --- Global Master Access ---
    match /{document=**} {
      allow read, write: if isEzra();
    }

    // --- Public Access Paths ---
    match /products/{productId} {
      allow read: if true;
    }

    match /categories/{categoryId} {
      allow read: if true;
    }

    match /business/{configId} {
      allow read: if true;
    }

    // --- User Specific Paths ---
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      match /orders/{orderId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}