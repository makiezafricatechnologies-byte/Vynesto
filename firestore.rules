rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Frewsie Shop Security Rules
     * 
     * CORE PHILOSOPHY:
     * This ruleset implements a robust User-Ownership model combined with Database-Based Access Control (DBAC).
     * It prioritizes absolute security for private user data while maintaining high performance for 
     * public product browsing.
     * 
     * DATA STRUCTURE:
     * - Public Data: /categories and /products are top-level and globally readable.
     * - Private Data: /users/{userId} and its subcollection /users/{userId}/orders are strictly user-scoped.
     * - Admin Privileges: Managed via the existence of a document in the /roles_admin/{uid} collection.
     * 
     * KEY SECURITY DECISIONS:
     * - Authorization Independence: User IDs are denormalized into document fields (e.g., Order.userId) 
     *   to allow atomic checks without parent-document lookups.
     * - Admin Access: A dedicated 'isAdmin()' helper checks the /roles_admin collection, allowing 
     *   administrators to bypass standard ownership restrictions for support and management.
     * - Structural Segregation: User-specific data is nested under UID-based paths, ensuring 
     *   that 'list' operations are automatically scoped to the authenticated user.
     * 
     * PROTOTYPING MODE:
     * These rules enforce strict authorization (who can access) and relational integrity (path-to-field matching)
     * but do not enforce strict data schemas (field types or presence) to allow for rapid development.
     */

    // --- Global Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Collection Rules ---

    /**
     * @description Rules for user profile documents. Users manage their own profiles; Admins have full access.
     * @path /users/{userId}
     * @allow (get/list) If the user is the owner or an admin.
     * @allow (create) If the user's UID matches the document ID.
     * @allow (update) If the user is the owner and preserves their ID, or if the user is an admin.
     * @deny (create) If the UID in the path does not match the authenticated user.
     * @principle Ownership and Relational Integrity.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if (isOwner(userId) && request.resource.data.id == resource.data.id) || isAdmin();
      allow delete: if isAdmin(); // Users generally shouldn't delete their own accounts in this shop flow.
    }

    /**
     * @description Publicly readable product categories. Writes restricted to administrators.
     * @path /categories/{categoryId}
     * @allow (get/list) For all users (public).
     * @allow (write) Only for administrators.
     * @deny (write) For any non-admin user.
     * @principle Structural Segregation (Public Read/Admin Write).
     */
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Publicly readable products. Writes restricted to administrators.
     * @path /products/{productId}
     * @allow (get/list) For all users (public).
     * @allow (write) Only for administrators.
     * @deny (write) For any non-admin user.
     * @principle Structural Segregation (Public Read/Admin Write).
     */
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Private user orders. Hierarchical path ensures strong ownership.
     * @path /users/{userId}/orders/{orderId}
     * @allow (get/list) If the user is the owner of the parent path or an admin.
     * @allow (create) If the user is the owner and the internal 'userId' field matches.
     * @allow (update/delete) If the user is the owner (preserving 'userId') or an admin.
     * @deny (list) If the user attempts to list orders belonging to another UID.
     * @principle Authorization Independence and Path-based Security.
     */
    match /users/{userId}/orders/{orderId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if (isExistingOwner(userId) && request.resource.data.userId == resource.data.userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Metadata collection for administrative privileges.
     * @path /roles_admin/{adminUid}
     * @allow (get) For any signed-in user (to check status).
     * @allow (list) For existing administrators only.
     * @allow (write) Denied for all (Admin assignment should happen via secure backend/console).
     * @deny (write) To prevent users from escalating their own privileges.
     * @principle Database-Based Access Control (DBAC).
     */
    match /roles_admin/{adminUid} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}