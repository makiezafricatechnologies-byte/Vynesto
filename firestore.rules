rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Master Admin Access for Ezra
    function isMasterAdmin() {
      return request.auth != null && (
        request.auth.uid == 'IELPepYQ6FTIWJ1ZWrDJFQFhn5C3' || 
        request.auth.token.email == 'ezramainak@gmail.com'
      );
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isMasterAdmin();
    }

    match /business/config {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    match /products/{prodId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }
    
    // Default deny for non-admin, but Ezra has master access everywhere
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }
  }
}