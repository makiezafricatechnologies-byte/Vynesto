rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Master Security Rules for Frewsie Shop
     * Ezra Maina (ezramainak@gmail.com) is the Master Admin.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isEzra() {
      return isSignedIn() && (
        request.auth.token.email == 'ezramainak@gmail.com' || 
        request.auth.uid == 'IELPepYQ6FTIWJ1ZWrDJFQFhn5C3'
      );
    }

    // --- Master Global Override ---
    // Ezra has absolute power over all collections.
    match /{document=**} {
      allow read, write: if isEzra();
    }

    // --- Public Read Access ---
    match /products/{productId} {
      allow read: if true;
    }

    match /categories/{categoryId} {
      allow read: if true;
    }

    // Specific match for business config with Ezra override
    match /business/{configId} {
      allow read: if true;
      allow write: if isEzra();
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      match /orders/{orderId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}