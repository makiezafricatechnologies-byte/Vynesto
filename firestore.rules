rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // MASTER ADMIN PROTOCOL: Ezra Maina
    // Unconditional master access granted to the primary owner account.
    function isMasterAdmin() {
      return request.auth != null && (
        request.auth.uid == 'IELPepYQ6FTIWJ1ZWrDJFQFhn5C3' || 
        request.auth.token.email == 'ezramainak@gmail.com'
      );
    }

    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /business/config {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    match /products/{prodId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }
  }
}