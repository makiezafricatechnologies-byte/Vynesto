{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "createdAt", "role"]
    },
    "Category": {
      "title": "Category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "image": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "image", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "wasPrice": { "type": "number" },
        "nowPrice": { "type": "number" },
        "imageUrls": { "type": "array", "items": { "type": "string" } },
        "isFeatured": { "type": "boolean" },
        "isPromotional": { "type": "boolean" },
        "flashSaleDays": { "type": "number" },
        "discountPercentage": { "type": "number" },
        "promoCode": { "type": "string" },
        "marketingBanner": {
          "type": "object",
          "properties": {
            "headline": { "type": "string" },
            "subheadline": { "type": "string" },
            "tip": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "category", "nowPrice", "imageUrls", "isFeatured", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/User",
      "description": "User profiles and roles."
    },
    "/categories/{categoryId}": {
      "schema": "#/entities/Category",
      "description": "Product category taxonomy."
    },
    "/products/{productId}": {
      "schema": "#/entities/Product",
      "description": "Store inventory and promotions."
    },
    "/business/config": {
      "schema": "object",
      "description": "Global business identity configuration."
    }
  }
}